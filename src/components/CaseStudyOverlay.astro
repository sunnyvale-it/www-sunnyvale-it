---
import { Icon } from 'astro-icon/components';

const cases = [
  {
    client: "FinTech Global",
    title: "Migrating Legacy Systems to the Cloud",
    category: "Cloud Migration",
    color: "bg-blue-900"
  },
  {
    client: "Healthcare Plus",
    title: "Securing Patient Data with Zero Trust",
    category: "Cybersecurity",
    color: "bg-teal-900"
  },
  {
    client: "Retail Logistics",
    title: "Automating Supply Chain Analytics",
    category: "Data Analytics",
    color: "bg-indigo-900"
  },
  {
    client: "Manufacturing Inc.",
    title: "Enterprise Resource Planning Upgrade",
    category: "IT Strategy",
    color: "bg-slate-800"
  }
];
---

<section class="section-padding bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mb-12 text-center case-header opacity-0 translate-y-4">
      <h2 class="text-sm font-bold text-accent uppercase tracking-widest mb-3">Case Studies</h2>
      <h3 class="text-3xl md:text-5xl font-bold text-primary">Proven Results.</h3>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {cases.map((item) => (
        <a href="#" class={`group relative h-80 rounded-2xl overflow-hidden block case-item opacity-0 translate-y-4 ${item.color}`}>
          <!-- Background image placeholder -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent z-10"></div>
          
          <div class="absolute inset-0 opacity-50 group-hover:opacity-30 transition-opacity duration-500 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSI0MCI+CjxyZWN0IHdpZHRoPSI0MCIgaGVpZ2h0PSI0MCIgZmlsbD0ibm9uZSIvPgo8Y2lyY2xlIGN4PSIyMCIgY3k9IjIwIiByPSIyIiBmaWxsPSIjZmZmZmZmIiBmaWxsLW9wYWNpdHk9IjAuMiIvPgo8L3N2Zz4=')]"></div>

          <div class="absolute inset-0 p-8 flex flex-col justify-end z-20">
            <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
              <div class="text-white/80 text-sm font-medium mb-2">{item.category}</div>
              <h4 class="text-2xl font-bold text-white mb-2">{item.title}</h4>
              <div class="text-white/60 text-sm">{item.client}</div>
            </div>
            
            <div class="absolute top-8 right-8 w-12 h-12 bg-white/10 backdrop-blur rounded-full flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transform translate-x-4 group-hover:translate-x-0 transition-all duration-300">
              <Icon name="lucide:arrow-up-right" class="w-6 h-6" />
            </div>
          </div>
        </a>
      ))}
    </div>
    
    <div class="mt-12 text-center">
      <a href="#all-cases" class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-primary bg-white hover:bg-surface-hover border border-border rounded transition-colors">
        View All Case Studies
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  gsap.to(".case-header", {
    scrollTrigger: {
      trigger: ".bg-surface",
      start: "top 80%",
    },
    y: 0,
    opacity: 1,
    duration: 0.8,
    ease: "power3.out"
  });

  gsap.to(".case-item", {
    scrollTrigger: {
      trigger: ".bg-surface",
      start: "top 60%",
    },
    y: 0,
    opacity: 1,
    duration: 0.6,
    stagger: 0.15,
    ease: "power3.out"
  });
</script>
