---
import { Icon } from 'astro-icon/components';
---

<section class="section-padding bg-primary text-white relative overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:32px_32px]"></div>
  
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      
      <div class="testimo-text opacity-0 translate-x-[-20px]">
        <h2 class="text-sm font-bold text-accent-light uppercase tracking-widest mb-3">Client Success</h2>
        <h3 class="text-3xl md:text-5xl font-bold mb-8 leading-tight text-white">Don't just take our word for it.</h3>
        <p class="text-slate-400 text-lg mb-8 max-w-md">
          We partner with industry leaders to deliver mission-critical infrastructure that drives revenue and secures data.
        </p>
        
        <div class="flex gap-4">
          <button class="w-12 h-12 rounded-full border border-slate-700 flex items-center justify-center hover:bg-slate-800 transition-colors">
            <Icon name="lucide:arrow-left" class="w-5 h-5" />
          </button>
          <button class="w-12 h-12 rounded-full bg-accent hover:bg-accent-light flex items-center justify-center transition-colors border border-transparent">
            <Icon name="lucide:arrow-right" class="w-5 h-5" />
          </button>
        </div>
      </div>
      
      <div class="relative testimo-card opacity-0 translate-x-[20px]">
        <Icon name="lucide:quote" class="w-24 h-24 text-slate-800 absolute -top-8 -left-8 z-0" />
        <div class="bg-slate-800/50 backdrop-blur-sm border border-slate-700 p-10 rounded-2xl relative z-10">
          <div class="flex gap-1 mb-6 text-yellow-400">
            <Icon name="lucide:star" class="w-5 h-5 fill-current" />
            <Icon name="lucide:star" class="w-5 h-5 fill-current" />
            <Icon name="lucide:star" class="w-5 h-5 fill-current" />
            <Icon name="lucide:star" class="w-5 h-5 fill-current" />
            <Icon name="lucide:star" class="w-5 h-5 fill-current" />
          </div>
          
          <p class="text-xl md:text-2xl font-medium leading-relaxed mb-8 text-slate-200">
            "Looka Consulting completely transformed our cloud infrastructure. Their team didn't just execute the migration; they provided strategic guidance that reduced our operational costs by 40%."
          </p>
          
          <div class="flex items-center gap-4 border-t border-slate-700 pt-6">
            <div class="w-12 h-12 rounded-full bg-slate-600"></div>
            <div>
              <div class="font-bold text-white">Sarah Jenkins</div>
              <div class="text-sm text-slate-400">CTO, Global Logistics</div>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  gsap.to(".testimo-text", {
    scrollTrigger: {
      trigger: ".bg-primary",
      start: "top 70%",
    },
    x: 0,
    opacity: 1,
    duration: 0.8,
    ease: "power3.out"
  });

  gsap.to(".testimo-card", {
    scrollTrigger: {
      trigger: ".bg-primary",
      start: "top 70%",
    },
    x: 0,
    opacity: 1,
    duration: 0.8,
    ease: "power3.out",
    delay: 0.2
  });
</script>
