---
import { Icon } from 'astro-icon/components';
---

<section class="py-12 border-b border-border bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <p class="text-center text-sm font-semibold text-foreground-muted mb-8 uppercase tracking-wider">Trusted by industry leaders worldwide</p>
    
    <div class="flex flex-wrap justify-center gap-12 md:gap-20 opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
      <!-- Placeholder SVG logos since we don't have actual images -->
      <div class="flex items-center gap-2 font-bold text-xl text-primary">
        <Icon name="lucide:globe" class="w-6 h-6" /> Acme Corp
      </div>
      <div class="flex items-center gap-2 font-bold text-xl text-primary">
        <Icon name="lucide:box" class="w-6 h-6" /> Globex
      </div>
      <div class="flex items-center gap-2 font-bold text-xl text-primary">
        <Icon name="lucide:triangle" class="w-6 h-6" /> Soylent
      </div>
      <div class="flex items-center gap-2 font-bold text-xl text-primary">
        <Icon name="lucide:hexagon" class="w-6 h-6" /> Initech
      </div>
      <div class="hidden md:flex items-center gap-2 font-bold text-xl text-primary">
        <Icon name="lucide:circle" class="w-6 h-6" /> Umbrella
      </div>
    </div>
  </div>
</section>
