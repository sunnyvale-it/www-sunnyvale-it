---
const clients = [
  { file: "LM.png", url: "https://www.leroymerlin.it/" },
  { file: "LogoFHD_4-1.png", url: "https://www.its-ictppiemonte.it/" },
  {
    file: "PUNCH-Softronix-2.png",
    url: "https://www.dumarey.com/group/worldwide-locations/dumarey-softronix",
  },
  { file: "acus.png", url: "https://www.acus.it/" },
  { file: "argotec.png", url: "https://www.argotecgroup.com/" },
  { file: "boscolo.png", url: "https://www.boscolo.com/" },
  { file: "bricocenter_color1.png", url: "https://www.bricocenter.it/" },
  { file: "credit-data1.png", url: "https://creditdataresearch.com/" },
  { file: "dnata.png", url: "https://www.dnata.com/" },
  { file: "dum1.png", url: "https://www.dumarey.com/" },
  { file: "ett.png", url: "https://ettsolutions.com/" },
  { file: "intesa-sanpaolo.png", url: "https://www.intesasanpaolo.com/" },
  {
    file: "intesa-sanpaolo2.png",
    url: "https://www.internationalvalueservices.com",
  },
  { file: "ire_white_rightsize.png", url: "https://www.gruppoiren.it/" },
  { file: "logo-mz-4.png", url: "https://www.mzb-group.com" },
  { file: "mauden_colore.png", url: "https://www.mauden.com/" },
  { file: "oracle.png", url: "https://www.oracle.com/" },
  { file: "reply.png", url: "https://www.reply.com/" },
  { file: "roar.png", url: "https://roartec.com/" },
  { file: "societe-general-1.png", url: "https://www.societegenerale.com/" },
  { file: "step.png", url: "https://www.step.it/" },
  { file: "tecnomat.png", url: "https://www.tecnomat.it/" },
];

import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<style>
  .marquee-wrapper {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    width: 100%;

    /* Hide scrollbars for a clean look */
    -ms-overflow-style: none;
    scrollbar-width: none;

    /* Subtle gradient mask */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
  }
  .marquee-wrapper::-webkit-scrollbar {
    display: none;
  }
  .marquee-inner {
    display: flex;
    width: max-content;
  }
</style>

<section class="py-12 bg-white border-b border-border overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 mb-8">
    <p
      class="text-center text-sm font-bold text-[rgb(30,32,74)] uppercase tracking-widest"
    >
      {t("trust.title")}
    </p>
  </div>

  <div id="logo-marquee" class="marquee-wrapper">
    <div class="marquee-inner">
      <!-- First instance of logos -->
      <div class="gap-8 lg:gap-16 px-6 lg:px-10 shrink-0 flex items-center">
        {
          clients.map((client) => (
            <div class="w-40 md:w-56 h-16 md:h-24 flex items-center justify-center shrink-0">
              <a
                href={client.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full h-full flex items-center justify-center outline-none border-none no-underline"
              >
                <img
                  src={`/clients/${client.file}`}
                  class={`max-w-full max-h-full object-contain grayscale opacity-50 mix-blend-multiply hover:grayscale-0 hover:opacity-100 transition-all duration-300 transform-gpu border-none outline-none ${client.file.includes("white") ? "brightness-0 opacity-40 hover:brightness-0 hover:opacity-80" : ""} ${client.file.includes("dnata") ? "scale-50" : ""}`}
                  alt="Client Logo"
                  style="-webkit-backface-visibility: hidden; -webkit-transform: translate3d(0, 0, 0);"
                />
              </a>
            </div>
          ))
        }
      </div>
      <!-- Duplicate for seamless loop -->
      <div class="gap-8 lg:gap-16 px-6 lg:px-10 shrink-0 flex items-center">
        {
          clients.map((client) => (
            <div class="w-40 md:w-56 h-16 md:h-24 flex items-center justify-center shrink-0">
              <a
                href={client.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full h-full flex items-center justify-center outline-none border-none no-underline"
              >
                <img
                  src={`/clients/${client.file}`}
                  class={`max-w-full max-h-full object-contain grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-300 transform-gpu border-none outline-none ${client.file.includes("white") ? "brightness-0 opacity-40 hover:brightness-0 hover:opacity-80" : ""} ${client.file.includes("dnata") ? "scale-50" : ""}`}
                  alt="Client Logo"
                  style="-webkit-backface-visibility: hidden; -webkit-transform: translate3d(0, 0, 0);"
                />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const container = document.getElementById("logo-marquee");

  if (container) {
    let isPaused = false;
    let pauseTimeout;

    // Pause auto-scroll when user interacts (especially crucial for Safari momentum scrolling)
    const pauseScroll = () => {
      isPaused = true;
      clearTimeout(pauseTimeout);
      // Resume auto-scroll 1.5 seconds after they stop touching/scrolling
      pauseTimeout = setTimeout(() => {
        isPaused = false;
      }, 1500);
    };

    container.addEventListener("mouseenter", () => (isPaused = true));
    container.addEventListener("mouseleave", () => {
      isPaused = false;
      clearTimeout(pauseTimeout);
    });
    container.addEventListener("touchstart", pauseScroll, { passive: true });
    container.addEventListener("wheel", pauseScroll, { passive: true });

    function autoScroll() {
      if (!isPaused) {
        container.scrollLeft += 1;

        // If we've scrolled past the first set of logos, seamlessly reset to the start
        if (container.scrollLeft >= container.scrollWidth / 2) {
          container.scrollLeft = 0;
        }
      }
      requestAnimationFrame(autoScroll);
    }

    // Start loop
    requestAnimationFrame(autoScroll);
  }
</script>
