---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import CaseStudyOverlay from '../components/CaseStudyOverlay.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

// Looka Theme Recreation - Main Entry
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={lang === 'it' ? "Sunnyvale S.r.l. | IT Enterprise Strategico" : "Sunnyvale S.r.l. | Strategic Enterprise IT"}>
  <Header />
  
  <main>
    <Hero />
    <TrustBar />
    
    <!-- Brief About Snippet -->
    <section id="about" class="section-padding bg-white relative overflow-hidden">
      <!-- Subtle Background Grid -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
      
      <div class="max-w-4xl mx-auto px-6 text-center about-anim opacity-0 translate-y-4 relative z-10">
        <h2 class="text-2xl md:text-4xl font-bold text-primary leading-tight mb-6">
          {lang === 'it' ? "Non ci limitiamo a consigliare la tecnologia. Progettiamo l'infrastruttura che alimenta la crescita della tua azienda." : "We don't just recommend technology. We engineer the infrastructure that powers your business growth."}
        </h2>
        <p class="text-lg text-foreground-muted">
          {lang === 'it' ? "Fondata da veterani del settore, Sunnyvale colma il divario tra strategia di alto livello ed esecuzione tecnica. Collaboriamo con CIO e leader tecnologici per affrontare trasformazioni digitali complesse." : "Founded by industry veterans, Sunnyvale bridges the gap between high-level strategy and technical execution. We partner with CIOs and technology leaders to navigate complex digital transformations."}
        </p>
      </div>
    </section>

    <ServiceGrid />
    <CaseStudyOverlay />
    <Testimonials />
    
    <!-- CTA Section -->
    <section id="contact" class="section-padding bg-accent text-white text-center">
      <div class="max-w-3xl mx-auto px-6 cta-anim opacity-0 translate-y-4">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          {lang === 'it' ? "Pronto a scalare la tua infrastruttura?" : "Ready to scale your infrastructure?"}
        </h2>
        <p class="text-xl text-blue-100 mb-10">
          {lang === 'it' ? "Prenota una call conoscitiva con i nostri architetti senior per discutere delle tue sfide e obiettivi specifici." : "Schedule a discovery call with our senior architects to discuss your specific challenges and objectives."}
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="#" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-accent bg-white hover:bg-slate-50 rounded transition-colors shadow-lg">
            {lang === 'it' ? "Prenota una Call" : "Schedule Discovery Call"}
          </a>
          <a href="#" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-accent-dark hover:bg-primary rounded transition-colors border border-transparent">
            {lang === 'it' ? "Contatta le Vendite" : "Contact Sales"}
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  gsap.to(".about-anim", {
    scrollTrigger: {
      trigger: "#about",
      start: "top 80%",
    },
    y: 0,
    opacity: 1,
    duration: 0.8,
    ease: "power3.out"
  });

  gsap.to(".cta-anim", {
    scrollTrigger: {
      trigger: "#contact",
      start: "top 80%",
    },
    y: 0,
    opacity: 1,
    duration: 0.8,
    ease: "power3.out"
  });
</script>
