---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`${t('about.title')} | Sunnyvale S.r.l.`}>
  <Header />
  
  <main class="pt-32 pb-24 min-h-screen bg-slate-50 relative overflow-hidden">
    <!-- Catchy Background Effects -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <div class="absolute -top-[10%] -right-[10%] w-[40%] h-[40%] rounded-full bg-accent/5 blur-[120px]"></div>
      <div class="absolute bottom-[10%] -left-[10%] w-[50%] h-[50%] rounded-full bg-blue-400/5 blur-[120px]"></div>
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(#0f172a 1px, transparent 1px); background-size: 32px 32px;"></div>
    </div>

    <div class="max-w-6xl mx-auto px-6 relative z-10">
      
      <!-- Row 1 -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-24">
        
        <!-- Image Section -->
        <div class="about-anim opacity-0 translate-y-8 relative">
          <!-- Decorative backing -->
          <div class="absolute -inset-4 bg-gradient-to-br from-accent/20 to-transparent rounded-3xl blur-lg z-0"></div>
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-border bg-white z-10 aspect-[4/5] lg:aspect-[3/4]">
            <img 
              src="/about-banner.jpg" 
              alt="Sunnyvale banner" 
              class="w-full h-full object-cover object-center"
              onerror="this.src='https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&q=80&w=1000';"
            />
          </div>
        </div>

        <!-- Text Section -->
        <div class="about-anim opacity-0 translate-y-8 flex flex-col justify-center">
          <h1 class="text-4xl md:text-5xl font-extrabold text-primary mb-4 tracking-tight">{t('about.title')}</h1>
          <p class="text-xl text-foreground-muted font-medium mb-8 leading-relaxed">{t('about.intro.p1')}</p>
          <div class="w-16 h-1 bg-accent rounded-full mb-10"></div>
          
          <div class="prose prose-lg text-foreground-muted leading-relaxed font-medium">
            <p class="mb-6 font-semibold text-primary text-xl">{t('about.intro.p2')}</p>
            <p class="mb-6">{t('about.intro.p3')}</p>
            <p class="mb-0">{t('about.p1')}</p>
          </div>
        </div>
      </div>

      <!-- Row 2 -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        
        <!-- Text Section 2 (Order swapped on desktop for zig-zag) -->
        <div class="about-anim opacity-0 translate-y-8 flex flex-col justify-center order-2 lg:order-1">
          <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6 tracking-tight">{t('about.achievements.title')}</h2>
          <div class="prose prose-lg text-foreground-muted leading-relaxed font-medium">
            <p class="mb-6">{t('about.p2')}</p>
            <p class="mb-6">{t('about.p3')}</p>
            <p class="mb-0">{t('about.p4')}</p>
          </div>
        </div>

        <!-- Image Section 2 -->
        <div class="about-anim opacity-0 translate-y-8 relative order-1 lg:order-2">
          <!-- Decorative backing -->
          <div class="absolute -inset-4 bg-gradient-to-tl from-accent/20 to-transparent rounded-3xl blur-lg z-0"></div>
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-border bg-white z-10 aspect-[4/5] lg:aspect-[3/4]">
            <!-- Second image placeholder -->
            <img 
              src="/about-team.jpg" 
              alt="Sunnyvale team" 
              class="w-full h-full object-cover object-center"
              onerror="this.src='https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=1000';"
            />
          </div>
        </div>
      </div>
      
    </div>
  </main>
  
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  // Staggered animation for the two columns
  gsap.to(".about-anim", {
    y: 0,
    opacity: 1,
    duration: 0.8,
    stagger: 0.2,
    ease: "power3.out"
  });
</script>
